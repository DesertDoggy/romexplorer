+	/// romexplorer addition (see patches/01_igdb.patch): one page of every game on a
+	/// platform, for the `by_platform` bulk sync -- or, with `updated_since` (unix seconds),
+	/// only those IGDB changed after it (a diff sync). IGDB caps `limit` at 500.
+	pub async fn get_games_by_platform(
+		&self,
+		platform_id: i32,
+		updated_since: Option<i64>,
+		limit: usize,
+		offset: usize,
+	) -> anyhow::Result<Vec<Game>> {
+		let since = updated_since.map(|t| format!(" & updated_at > {t}")).unwrap_or_default();
+		self.do_request_parsed::<Vec<Game>>(
+			Method::POST,
+			IGDB_ROUTE_GAMES,
+			None,
+			Some(&format!("where platforms = ({platform_id}){since}; sort id asc;")),
+			Some(&format!("limit {}; offset {offset};", limit.min(500))),
+		)
+		.await
+	}
+
+	/// romexplorer addition: how many games IGDB has (`games/count`), on one platform or
+	/// overall -- the denominator for "how much of IGDB is cached".
+	/// With `updated_since` (unix seconds): only games changed after it -- a cheap
+	/// "did anything change?" check.
+	pub async fn count_games(&self, platform_id: Option<i32>, updated_since: Option<i64>) -> anyhow::Result<i64> {
+		#[derive(serde::Deserialize)]
+		struct Count {
+			count: i64,
+		}
+		let mut conditions: Vec<String> = Vec::new();
+		if let Some(p) = platform_id {
+			conditions.push(format!("platforms = ({p})"));
+		}
+		if let Some(t) = updated_since {
+			conditions.push(format!("updated_at > {t}"));
+		}
+		let filter = if conditions.is_empty() { String::new() } else { format!("where {};", conditions.join(" & ")) };
+		let count = self
+			.do_request_parsed::<Count>(Method::POST, &format!("{IGDB_ROUTE_GAMES}/count"), Some(""), Some(&filter), Some(""))
+			.await?;
+		Ok(count.count)
+	}
+
