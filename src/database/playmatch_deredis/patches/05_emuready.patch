+		limit: i64,
+	) -> anyhow::Result<Vec<EmuReadyGame>> {
+		#[derive(Serialize)]
+		struct Input<'a> {
+			#[serde(rename = "systemId")]
+			system_id: &'a str,
+			page: i64,
+			limit: i64,
+		}
+		let payload = Input {
+			system_id,
+			page,
+			limit: limit.clamp(1, SEARCH_LIMIT),
+		};
