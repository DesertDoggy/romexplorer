[submodule "external/zlib-ng"]
	path = external/zlib-ng
	url = https://github.com/zlib-ng/zlib-ng
[submodule "external/openssl"]
	path = external/openssl
	url = https://github.com/openssl/openssl
[submodule "external/mariadb-server"]
	path = external/mariadb-server
	url = https://github.com/MariaDB/server
	# Our patches (deps/mariadb-server/patches/) are applied to the checkout at build time.
	ignore = dirty
[submodule "external/mariadb-connector-c"]
	path = external/mariadb-connector-c
	url = https://github.com/mariadb-corporation/mariadb-connector-c
[submodule "external/chdman-simd"]
	path = external/chdman-simd
	url = https://github.com/grouik1er-coder/chdman-simd
[submodule "external/7-Zip-zstd"]
	path = external/7-Zip-zstd
	url = https://github.com/mcmilk/7-Zip-zstd
	# Our patches (deps/7-Zip-zstd/patches/) are applied to the checkout at build time.
	ignore = dirty
[submodule "external/RALibretro"]
	path = external/RALibretro
	url = https://github.com/RetroAchievements/RALibretro
	# Our patches (deps/RALibretro/patches/) are applied to the checkout at build time.
	ignore = dirty
[submodule "external/dolphin"]
	path = external/dolphin
	url = https://github.com/dolphin-emu/dolphin
[submodule "external/mame"]
	path = external/mame
	url = https://github.com/mamedev/mame
	# Untracked files only: an IDE restoring the C# project under 3rdparty/zlib/contrib/nuget
	# writes obj/ beside it; no build here writes into this tree.
	ignore = untracked
[submodule "external/playmatch"]
	path = external/playmatch
	url = https://github.com/RetroRealm/playmatch
