[Desktop Entry]
Type=Application
Name=romexplorer
GenericName=ROM Collection Manager
Comment=Catalogue, verify and browse a ROM collection
# Rewritten by AppRun --install to the AppImage's real path; appimagetool also requires the
# key to be present here.
Exec=romexplorer
