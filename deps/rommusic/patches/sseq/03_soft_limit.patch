+// Above the knee, peaks are bent towards full scale instead of cut off at it: a few loud songs
+// still sum past it after the mix gain, and a hard clamp there crackles.
+static inline int32_t SoftLimit(int32_t x)
+{
+	const int32_t knee = 0x5000;
+	const int32_t mag = x < 0 ? -x : x;
+	if (mag <= knee)
+		return x;
+	const double room = 0x7FFF - knee;
+	const int32_t bent = knee + static_cast<int32_t>(room * std::tanh((mag - knee) / room));
+	return x < 0 ? -bent : bent;
+}
