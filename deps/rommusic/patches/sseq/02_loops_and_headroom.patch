+
+void Player::Jumped(int track)
+{
+	if (track < 0 || track >= FSS_MAXTRACKS)
+		return;
+	if (this->jumps[track][0] < 0)
+		this->jumps[track][0] = static_cast<int64_t>(this->clocks);
+	else if (this->jumps[track][1] < 0)
+		this->jumps[track][1] = static_cast<int64_t>(this->clocks);
 }
 
